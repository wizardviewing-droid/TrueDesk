{
  "name": "true-desk",
  "version": "1.0.23",
  "private": true,
  "main": "main.cjs",
  "description": "True Solicitors accounts desk",
  "scripts": {
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.truesolicitors.truedesk",
    "productName": "True Desk",
    "executableName": "TrueDesk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "packed",
        "to": "app-server"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "True Desk"
    },
    "portable": {
      "artifactName": "TrueDesk.exe"
    }
  }
}
